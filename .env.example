# ChooChoo deployment configuration.
#
# Copy this file to .env in the project root on each Pi and fill in the
# values for that Pi's role. Docker Compose automatically loads .env.
#
# Single-host Docker setup (default): leave everything commented out.
# The defaults are correct for all services on one host sharing br-choochoo0.
#
# Multi-Pi physical deployment: uncomment and set the variables that apply
# to the services running on this Pi. Only the variables relevant to the
# services you are starting on this Pi need to be set.
#
# ── MQTT broker location ────────────────────────────────────────────────────
# Set on: Pi running web-mqtt, switch-controller-mqtt, web-modbus (dual mode),
#         controller-modbus (dual mode).
# Default: "mosquitto" (Docker container name, works on single-host).

# MQTT_BROKER_HOST=192.168.88.11
# MQTT_BROKER_PORT=1883

# ── Modbus controller location ──────────────────────────────────────────────
# Set on: Pi running web-modbus.
# Default: "controller" (Docker container name, works on single-host).

# MODBUS_CONTROLLER_HOST=192.168.88.12
# MODBUS_CONTROLLER_PORT=5020

# ── Zeek capture interface ───────────────────────────────────────────────────
# Set on: Pi running the sensor (Zeek + Vector) profile.
# Default: br-choochoo0 (Docker bridge, single-host mode).
# Physical SPAN NIC: set to the interface receiving mirrored traffic from the
# MikroTik switch (typically eth0 or eth1 depending on Pi wiring).

# ZEEK_IFACE=eth0

# ── Zeek authorized IPs ──────────────────────────────────────────────────────
# Set on: Pi running the sensor (Zeek + Vector) profile.
# These tell Zeek which IPs are legitimate so it fires detections against
# everything else. On a physical deployment these are the real LAN IPs of
# the web-modbus and web-mqtt Pis.
# Leave unset to disable the corresponding detection category entirely
# (useful during initial setup before you know the IPs).

# MODBUS_MASTER_IP=192.168.88.13     # IP of Pi running web-modbus
# MQTT_PUBLISHER_IP=192.168.88.14    # IP of Pi running web-mqtt

# ── Gravwell ingest address ──────────────────────────────────────────────────
# Set on: Pi running the sensor (Zeek + Vector) profile.
# Default: 192.168.1.201:7777 (home lab Proxmox CT 201).
# At a venue: set to the Gravwell host's IP on the event network.

# GRAVWELL_INGEST_ADDR=192.168.88.20:7777

# ── Web dashboard port (Modbus mode) ────────────────────────────────────────
# Set on: Pi running web-modbus alongside web-mqtt on the same host.
# When both run on the same Pi, one must use a different port.
# Default: 8000 (conflicts with web-mqtt). Set to 8001 when co-hosting.

# MODBUS_WEB_PORT=8001

# ── Admin panel credentials ──────────────────────────────────────────────────
# Set on: Pi running the admin profile.
# Change before any public event — the admin panel has full docker + iptables access.

# ADMIN_USER=admin
# ADMIN_PASSWORD=choochoo-admin

# ── Admin panel service targets ──────────────────────────────────────────────
# Set on: Pi running the admin profile in a multi-Pi deployment.
# Both point at the web-modbus Pi — it hosts the Modbus bridge and the
# SwitchBridge MQTT client used for switch throw commands.
# In single-host mode the defaults (localhost:8001 / localhost:8000) are correct.

# TRAIN_API_URL=http://192.168.88.12:8000
# SWITCH_API_URL=http://192.168.88.12:8000

# ── Admin panel network stats interface ──────────────────────────────────────
# Set on: Pi running the admin profile.
# Defaults to eth0 (correct for a dedicated admin Pi with no Docker bridge).
# Set to br-choochoo0 only when admin is co-hosted with the Docker stack.

# STATS_IFACE=eth0

# ── Gravwell dashboard provisioning ─────────────────────────────────────────
# Set on: the host that runs lab-up.sh.
# Default: http://localhost:8080 (local Docker Gravwell).
# Physical deployment: set to the Gravwell Pi/host URL.

# GRAVWELL_URL=http://192.168.88.20:8080
# GRAVWELL_PASS=changeme

# ── Reference: suggested IP plan for a 6-Pi + Microsensor deployment ────────
#
# Subnet: 192.168.88.0/24 (MikroTik default LAN)
# MikroTik router:                 192.168.88.1
#
# Pi-1  mosquitto broker:          192.168.88.11  (Docker: mqtt profile)
# Pi-2  web-modbus:                192.168.88.12  (Docker: modbus profile)
# Pi-3  controller-modbus:         192.168.88.13  (bare metal systemd, BLE → BuWizz)
# Pi-4  switch-controller:         192.168.88.14  (bare metal systemd, BLE → Cube)
# Pi-5  admin panel:               192.168.88.15  (Docker: admin profile)
# Pi-6  spare / hardened demo:     192.168.88.16
# Microsensor (Corelight):         192.168.88.20  (Zeek + ICSNPP + shipper, SPAN port)
#
# Pi-2 .env:
#   MQTT_BROKER_HOST=192.168.88.11
#   MODBUS_CONTROLLER_HOST=192.168.88.13
#   MODBUS_CONTROLLER_PORT=502
#
# Pi-5 .env:
#   TRAIN_API_URL=http://192.168.88.12:8000
#   SWITCH_API_URL=http://192.168.88.12:8000
#   STATS_IFACE=eth0
#
# MikroTik SPAN config (RouterOS):
#   /tool sniffer
#     set streaming-enabled=yes streaming-server=192.168.88.20
#   (or use switch chip mirror port if the CRS/CSS switch supports it)
