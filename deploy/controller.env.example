# /etc/choochoo/controller.env — read by the systemd service.
# Lines are KEY=VALUE; no shell expansion. Quote values containing spaces.

# Broker host. The Pi dials out to this address over MQTT.
CHOOCHOO_BROKER=10.0.0.1

# Drive a real Powered Up train via BLE (vs the FakeTrain backend).
CHOOCHOO_TRAIN=powered_up

# Train ID — must match what publishers/UIs use when forming topics.
# Useful for distinguishing multiple trains at one event.
CHOOCHOO_TRAIN_ID=t1

# BLE name to filter on. Default is "Smart Hub" (factory name).
# If the hub was renamed via the Lego Powered Up app, set the exact name here.
#CHOOCHOO_HUB_NAME=HUB NO.4

# --- Hardened broker (optional) ----------------------------------------------
# Uncomment and copy the CA cert + creds to enable TLS + auth.
#CHOOCHOO_TLS_CA=/etc/choochoo/ca.crt
#CHOOCHOO_USER=controller
#CHOOCHOO_PASSWORD=replace-me
