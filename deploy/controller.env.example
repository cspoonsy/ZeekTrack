# /etc/choochoo/controller.env — read by the systemd service.
# Lines are KEY=VALUE; no shell expansion. Quote values containing spaces.

# --- Legacy MQTT-controller mode --------------------------------------------
# The variables below apply when CHOOCHOO_PROTOCOL is unset (defaults to
# mqtt). Under the ChooChoo event configuration we use Modbus instead —
# see the "Modbus outstation mode" section below.

# Broker host. The Pi dials out to this address over MQTT.
CHOOCHOO_BROKER=10.0.0.1

# Drive a real train via BLE (vs the FakeTrain backend).
CHOOCHOO_TRAIN=powered_up

# Train ID — must match what publishers/UIs use when forming topics.
# Useful for distinguishing multiple trains at one event.
CHOOCHOO_TRAIN_ID=t1

# BLE name to filter on. Defaults per backend:
#   powered_up -> "Smart Hub" (Lego factory default)
#   buwizz     -> "BuWizz3"
# If the hub was renamed via the vendor app, set the exact name here.
#CHOOCHOO_HUB_NAME=HUB NO.4
#CHOOCHOO_BUWIZZ_NAME=BuWizz3

# --- Modbus outstation mode (event configuration) ---------------------------
# When CHOOCHOO_PROTOCOL=modbus, the process runs a Modbus/TCP outstation
# on port 5020 instead of subscribing to an MQTT broker. It also acts as
# an MQTT client to the switch broker so the switch's DIs/coils on the
# outstation stay in sync — see M10 in VULNERABILITIES.md.
#
#CHOOCHOO_PROTOCOL=modbus
#CHOOCHOO_TRAIN=buwizz
#CHOOCHOO_BUWIZZ_NAME=BuWizz3
#CHOOCHOO_MODBUS_PORT=5020
#CHOOCHOO_MODBUS_BIND=0.0.0.0
#
# Where the switch's broker lives. On the Pi running the whole event
# stack, this is localhost (mosquitto is published on the host).
#CHOOCHOO_SWITCH_BROKER=localhost
#CHOOCHOO_SWITCH_BROKER_PORT=1883
#CHOOCHOO_SWITCH_ID=sw1

# --- Hardened broker (optional) ----------------------------------------------
# Uncomment and copy the CA cert + creds to enable TLS + auth.
#CHOOCHOO_TLS_CA=/etc/choochoo/ca.crt
#CHOOCHOO_USER=controller
#CHOOCHOO_PASSWORD=replace-me
