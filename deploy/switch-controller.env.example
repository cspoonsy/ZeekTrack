# /etc/choochoo/switch-controller.env — read by the systemd service.
# Lines are KEY=VALUE; no shell expansion. Quote values containing spaces.

# Broker host. The Pi dials out to this address over MQTT.
# For an event running the whole stack on one Pi, this is localhost.
CHOOCHOO_BROKER=localhost

# Switch backend. Use `circuit_cube` for real BLE hardware, `fake` for dev.
CHOOCHOO_SWITCH_KIND=circuit_cube

# Switch ID — must match what publishers/UIs use when forming topics.
# Useful for distinguishing multiple switches on one broker.
CHOOCHOO_SWITCH_ID=sw1

# Substring of the Circuit Cube's advertised BLE name. The vendor
# ships Cubes as "TenkaXXXX" where XXXX is a 4-char suffix; the
# default "Tenka" substring matches any of them. Override if you
# have several on-site and need to pin to a specific one.
CHOOCHOO_CUBE_NAME=Tenka

# Which Cube motor port drives this switch's motor: a, b, or c.
CHOOCHOO_CUBE_PORT=a

# --- Hardened broker (optional) ----------------------------------------------
# Uncomment and copy the CA cert + creds to enable TLS + auth.
#CHOOCHOO_TLS_CA=/etc/choochoo/ca.crt
#CHOOCHOO_USER=switch-controller
#CHOOCHOO_PASSWORD=replace-me
