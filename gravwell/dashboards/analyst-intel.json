{
  "Name": "ChooChoo \u2014 Analyst Intel [1h]",
  "Description": "One-hour analyst view. Shows who is doing what, which protocols they touched, and early indicators of recon or exploitation.",
  "Data": {
    "timeframe": {
      "durationString": "PT1H",
      "timeframe": "iso",
      "timezone": null,
      "start": null,
      "end": null
    },
    "searches": [
      {
        "alias": "protocols",
        "query": "tag=corelight json \"_path\" | count by \"_path\" over 1h | chart count by \"_path\"",
        "color": null
      },
      {
        "alias": "top_talkers_conn",
        "query": "tag=corelight_conn | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" | count by \"id.orig_h\" over 1h | chart count by \"id.orig_h\"",
        "color": null
      },
      {
        "alias": "top_talkers_bytes",
        "query": "tag=corelight_conn | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" orig_bytes resp_bytes | stats sum(orig_bytes) as tx sum(resp_bytes) as rx by \"id.orig_h\" | sort by tx desc | table \"id.orig_h\" tx rx",
        "color": null
      },
      {
        "alias": "services_per_ip",
        "query": "tag=corelight_conn | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" \"id.resp_p\" service | table \"id.orig_h\" \"id.resp_p\" service",
        "color": null
      },
      {
        "alias": "mqtt_connects",
        "query": "tag=corelight_mqtt_connect | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" client_id connect_status proto_version | table \"id.orig_h\" client_id connect_status proto_version",
        "color": null
      },
      {
        "alias": "wildcard_sub",
        "query": "tag=corelight_mqtt_subscribe | grep \"#\" | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" topics | table \"id.orig_h\" topics",
        "color": null
      },
      {
        "alias": "client_id_collisions",
        "query": "tag=corelight_mqtt_connect | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" client_id | unique client_id \"id.orig_h\" | count by client_id | table client_id count",
        "color": null
      },
      {
        "alias": "modbus_reads",
        "query": "tag=corelight_modbus | grep \"\\\"pdu_type\\\":\\\"REQ\\\"\" | grep \"\\\"func\\\":\\\"READ\" | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" func | count by \"id.orig_h\" over 30s | chart count by \"id.orig_h\"",
        "color": null
      },
      {
        "alias": "modbus_by_ip",
        "query": "tag=corelight_modbus | grep \"\\\"pdu_type\\\":\\\"REQ\\\"\" | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" | count by \"id.orig_h\" over 30s | chart count by \"id.orig_h\"",
        "color": null
      },
      {
        "alias": "timeline",
        "query": "tag=corelight | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" | count by \"id.orig_h\" over 30s | chart count by \"id.orig_h\"",
        "color": null
      },
      {
        "alias": "port_scan",
        "query": "tag=corelight_conn | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" \"id.resp_p\" | count by \"id.orig_h\" \"id.resp_p\" | count by \"id.orig_h\" | sort by count desc | table \"id.orig_h\" count",
        "color": null
      },
      {
        "alias": "all_topics",
        "query": "tag=corelight_mqtt_publish | json topic | count by topic over 30s | chart count by topic",
        "color": null
      },
      {
        "alias": "mqtt_session_count",
        "query": "tag=corelight_mqtt_connect | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" | count | numbercard count",
        "color": null
      },
      {
        "alias": "unique_publishers",
        "query": "tag=corelight_mqtt_publish | grep \"\\\"from_client\\\":true\" | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" | unique \"id.orig_h\" | count | numbercard count",
        "color": null
      },
      {
        "alias": "gauge_unique_attackers",
        "query": "tag=corelight | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" | unique \"id.orig_h\" | count | gauge count",
        "color": null
      },
      {
        "alias": "gauge_total_events",
        "query": "tag=corelight count | gauge count",
        "color": null
      },
      {
        "alias": "mqtt_cmd_count",
        "query": "tag=corelight_mqtt_publish | grep \"\\\"from_client\\\":true\" | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" | count by \"id.orig_h\" | chart count by \"id.orig_h\"",
        "color": null
      },
      {
        "alias": "modbus_cmd_count",
        "query": "tag=corelight_modbus | grep \"\\\"pdu_type\\\":\\\"REQ\\\"\" | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" func | count by \"id.orig_h\" | chart count by \"id.orig_h\"",
        "color": null
      },
      {
        "alias": "sub_vs_pub",
        "query": "tag=corelight_mqtt_subscribe | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" | count by \"id.orig_h\" over 1h | chart count by \"id.orig_h\"",
        "color": null
      },
      {
        "alias": "off_namespace_pubs",
        "query": "tag=corelight_mqtt_publish | grep \"\\\"from_client\\\":true\" | grep -v \"choochoo/train/t1/cmd/motor\" | grep -v \"choochoo/train/t1/discovery\" | grep -v \"choochoo/train/t1/state\" | grep -v \"choochoo/train/t1/cmd/stop\" | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" topic | count by \"id.orig_h\" topic | table \"id.orig_h\" topic count",
        "color": null
      },
      {
        "alias": "modbus_func_by_ip",
        "query": "tag=corelight_modbus | grep \"\\\"pdu_type\\\":\\\"REQ\\\"\" | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json func | count by func over 1h | chart count by func",
        "color": null
      },
      {
        "alias": "web_requests_by_ip",
        "query": "tag=corelight_http | grep \"\\\"id.resp_p\\\":8000\" | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json \"id.orig_h\" | count by \"id.orig_h\" | sort by count desc | table \"id.orig_h\" count",
        "color": null
      },
      {
        "alias": "web_top_uris",
        "query": "tag=corelight_http | grep \"\\\"id.resp_p\\\":8000\" | grep -v \"\\\"id.orig_h\\\":\\\"fe80\" | grep -v \"\\\"id.orig_h\\\":\\\"ff02\" | json uri | count by uri over 1h | chart count by uri",
        "color": null
      },
      {
        "alias": "web_suspicious_detail",
        "query": "tag=corelight_http | grep \"\\\"id.resp_p\\\":8000\" | grep \"passwd\" | json \"id.orig_h\" method uri | table \"id.orig_h\" method uri",
        "color": null
      },
      {
        "alias": "ot_notice_count",
        "query": "tag=corelight_notice | count | numbercard count",
        "color": null
      },
      {
        "alias": "ot_notice_timeline",
        "query": "tag=corelight_notice | json note | count by note over 5m | chart count by note",
        "color": null
      },
      {
        "alias": "ot_notice_breakdown",
        "query": "tag=corelight_notice | json note | stats count by note | sort by count desc | table note count",
        "color": null
      },
      {
        "alias": "modbus_recon_profile",
        "query": "tag=corelight_modbus | json \"id.orig_h\" unit_ids_seen func_codes_tried exception_count write_count | table \"id.orig_h\" unit_ids_seen func_codes_tried exception_count write_count",
        "color": null
      },
      {
        "alias": "modbus_masters_first_seen",
        "query": "tag=corelight grep \"\\\"_path\\\":\\\"modbus_masters\\\"\" | json master first_seen write_count | table master first_seen write_count",
        "color": null
      },
      {
        "alias": "switch_throw_timeline",
        "query": "tag=corelight grep \"sw1/cmd/throw\" grep \"\\\"from_client\\\":true\" | count over 30s | chart count",
        "color": null
      },
      {
        "alias": "switch_outcome_distribution",
        "query": "tag=corelight grep \"sw1/event\" | json payload | regex -e payload \"\\\"outcome\\\":\\\"(?P<outcome>[^\\\"]+)\\\"\" | stats count by outcome | table outcome count",
        "color": null
      }
    ],
